# secrets
.env
.env.*
!.env.example

# the real endpoint list: no keys (auth_env only names the variable), but it holds
# the base_url of every candidate relay and of the self-hosted gateway.
# config/endpoints.example.json is the committed template — copy it and fill it in.
config/endpoints.json

# upstream Zenodo data (~52MB) — npm run fetch-data
data/upstream/
*.zip

# user baselines (contain endpoint URLs)
baselines/

# web-version run records saved by hand for analysis — same class as baselines/:
# no keys, but the endpoint URL and hostname are in there.
realtest/

# run artefacts: var/runs/*.json result files, and the SQLite db from milestone 2
var/

# runtime
node_modules/
*.log
tmp/
.DS_Store

# local tool state (serena regenerates it per machine)
.serena/
